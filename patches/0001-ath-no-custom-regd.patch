--- a/drivers/net/wireless/ath/regd.c
+++ b/drivers/net/wireless/ath/regd.c
@@ -640,28 +640,20 @@
 	const struct ieee80211_regdomain *regd;
 
 	wiphy->reg_notifier = reg_notifier;
-	wiphy->regulatory_flags |= REGULATORY_STRICT_REG |
-				   REGULATORY_CUSTOM_REG;
 
-	if (ath_is_world_regd(reg)) {
-		/*
-		 * Anything applied here (prior to wiphy registration) gets
-		 * saved on the wiphy orig_* parameters
-		 */
+	/* wfb-ath9k-lab patch: do not lock the wiphy to the EEPROM regdom.
+	 * Original code applied REGULATORY_STRICT_REG | REGULATORY_CUSTOM_REG
+	 * and wiphy_apply_custom_regulatory(), forcing channel limits to
+	 * intersection(EEPROM regdom, global). We skip that so the cfg80211
+	 * global regdom applies directly — channels 12-13 and full power
+	 * become reachable on AR9271 when paired with a permissive global
+	 * regdom (e.g. modparam cfg80211.ieee80211_regdom=BO).
+	 */
+	if (ath_is_world_regd(reg))
 		regd = ath_world_regdomain(reg);
-		wiphy->regulatory_flags |= REGULATORY_COUNTRY_IE_FOLLOW_POWER;
-	} else {
-		/*
-		 * This gets applied in the case of the absence of CRDA,
-		 * it's our own custom world regulatory domain, similar to
-		 * cfg80211's but we enable passive scanning.
-		 */
+	else
 		regd = ath_default_world_regdomain();
-	}
-
-	wiphy_apply_custom_regulatory(wiphy, regd);
-	ath_reg_apply_radar_flags(wiphy, reg);
-	ath_reg_apply_world_flags(wiphy, NL80211_REGDOM_SET_BY_DRIVER, reg);
+	(void)regd;
 	return 0;
 }
 
